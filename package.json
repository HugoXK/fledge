{
  "name": "fledge",
  "version": "0.2.0",
  "private": true,
  "description": "Hosted repositories that grow themselves, powered by FlyBot.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts bridge",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "mail:outbox": "node scripts/outbox.mjs",
    "db:backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
