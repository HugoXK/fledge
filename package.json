{
  "name": "fledge",
  "version": "0.3.3",
  "private": true,
  "description": "Hosted repositories that grow themselves, powered by FlyBot.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts bridge",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-lines=84 --test-coverage-include='src/**' test/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "mail:outbox": "node scripts/outbox.mjs",
    "mail:probe": "node scripts/mail-probe.mjs",
    "db:backup": "node scripts/backup.mjs",
    "db:restore-drill": "node scripts/restore-drill.mjs",
    "role:set": "node scripts/set-role.mjs",
    "role:set:dev": "tsx scripts/set-role.ts",
    "evolution:export": "node scripts/evolution-shadow.mjs",
    "evolution:report": "node scripts/evolution-shadow.mjs --report",
    "db:restore-drill:ci": "node scripts/restore-drill-ci.mjs",
    "artifacts:prune": "node scripts/artifact-retention.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "slo:report": "node scripts/slo-report.mjs",
    "trial:sweep": "tsx scripts/trial-sweep.ts",
    "visual:matrix": "tsx scripts/visual-matrix.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8",
    "nodemailer": "^10.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.92.0",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "glob": "^14.0.2"
  }
}
