# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
# Comma list of the proxy hops allowed to append X-Forwarded-For. Defaults to
# loopback (nginx on this host). Docker Compose as published: read the project's
# bridge gateway from the running project - docs/deploy.md, section 5 has the
# command - do not copy an address from an example. Never true, all or a /0
# range: the app refuses to start.
# TRUST_PROXY=127.0.0.1,::1
# Public URL used for OAuth callbacks, email links and cookies.
BASE_URL=http://localhost:8080
NODE_ENV=development

# 32+ random bytes, base64. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Exactly 32 bytes, base64. Encrypts GitHub tokens and user model keys at rest.
TOKEN_ENCRYPTION_KEY=

# ── GitHub OAuth App ─────────────────────────────────────────────────────
# Callback: ${BASE_URL}/auth/github/callback
# Leave these empty to use the landing page's GitHub token login fallback.
# In production, set ALLOW_TOKEN_LOGIN_ONLY=true to accept that fallback.
ALLOW_TOKEN_LOGIN_ONLY=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# `repo` lets Fledge read and open pull requests. Remove it if every user
# supplies a fine-grained token instead.
GITHUB_OAUTH_SCOPES=read:user user:email
# Your GitHub login. This account becomes the super admin on first login.
ADMIN_GITHUB_LOGIN=
# Local demo only. Leave empty in production; the app refuses to start otherwise.
DEV_LOGIN_LOGIN=
DEV_LOGIN_ADMIN=true
# Override only for GitHub Enterprise / tests.
GITHUB_API_BASE=https://api.github.com

# ── Email (application approvals) ─────────────────────────────────────────
# console = write .eml files to DATA_DIR/mail-outbox (development default).
MAIL_TRANSPORT=console
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=fledge@hugoxk.online
ADMIN_EMAIL=admin@hugoxk.online

# ── Platform model gateway ────────────────────────────────────────────────
# Any OpenAI-compatible /v1 endpoint. Keep the real endpoint out of git.
PLATFORM_LLM_BASE_URL=
PLATFORM_LLM_KEY=
PLATFORM_LLM_MODEL=your-model
# USD per token used when the upstream does not return a cost header.
PLATFORM_LLM_PRICE_PER_TOKEN=0.0000002
# 1 CNY by default. The gateway stops platform-funded calls at zero.
INITIAL_QUOTA_CNY=1
USD_CNY_RATE=7.2

# ── Service directory (console links) ─────────────────────────────────────
# Point these at your own deployments if you self-host the sibling services.
PORTAL_URL=https://portal.hugoxk.online
FLEDGE_DOCS_URL=https://fledge-docs.hugoxk.online/docs/
STATUS_URL=https://hugoxk.online/status/

# ── FlyBot runner ────────────────────────────────────────────────────────
# mock = local demo runner; flybot = per-repository FlyBot containers.
RUNNER_MODE=mock
# Optional global bridge, used only when no per-repository image is configured.
FLYBOT_BRIDGE_URL=
FLYBOT_BRIDGE_TOKEN=
JOB_TIMEOUT_MINUTES=90

# ── Per-repository FlyBot instances ───────────────────────────────────────
# Build a fixed FlyBot release image and pin it here. Empty disables containers.
FLYBOT_INSTANCE_IMAGE=
FLYBOT_INSTANCE_ROOT=./data/flybot-users
FLYBOT_BRIDGE_SCRIPT=bridge/flybot-bridge.mjs
FLYBOT_NETWORK_PREFIX=fledge
FLYBOT_DSH_PORT_START=31000
FLYBOT_BRIDGE_PORT_START=32000
FLYBOT_MODEL_PORT_START=33000
FLYBOT_MEMORY=2g
FLYBOT_CPUS=1
FLYBOT_MODEL=your-model
FLYBOT_TEAM_TIMEOUT_SECONDS=180
# Workspace snapshots (…/data/bot/workspace/r<number>) are not reclaimed by
# Fledge itself; `npm run artifacts:prune` is the operator tool. It keeps the
# newest ARTIFACT_RETENTION_KEEP snapshots and anything younger than
# ARTIFACT_RETENTION_MAX_AGE_DAYS, and never a workspace a state file names.
# An empty ARTIFACT_RETENTION_ROOT means FLYBOT_INSTANCE_ROOT; empty or
# whitespace-only KEEP/MAX_AGE_DAYS values take their defaults (never 0).
ARTIFACT_RETENTION_KEEP=3
ARTIFACT_RETENTION_MAX_AGE_DAYS=14
ARTIFACT_RETENTION_ROOT=

# ── Storage ──────────────────────────────────────────────────────────────
DATA_DIR=./data
# Optional; defaults to DATA_DIR/backups.
# BACKUP_DIR=./data/backups
DB_PATH=./data/fledge.db
# Allow http://localhost / private-IP model endpoints (development only).
ALLOW_PRIVATE_MODEL_URLS=false

# Daily summary email (local hour in DIGEST_TIMEZONE)
DIGEST_HOUR=9
DIGEST_TIMEZONE=Asia/Shanghai

# Optional GitHub App (recommended for repo onboarding)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=
# Opt in to using the signed-in user's OAuth token for App-repository jobs.
# This improves PR attribution but hands the job a broader account-scoped token.
GITHUB_APP_USER_TOKEN=false
GITHUB_APP_SETUP_URL=https://fledge.example/auth/github/app/installed
GITHUB_APP_CALLBACK_URL=https://fledge.example/auth/github/app/callback

# Inbound email replies (daily digest Reply-To); shared secret with the Email Worker
INBOUND_EMAIL_SECRET=
# Fail a running job after this many minutes without a callback/heartbeat.
JOB_STALL_MINUTES=30
# Maximum jobs running at once across all repositories.
PLATFORM_MAX_ACTIVE_JOBS=2
# Durable dispatcher: enqueue the job, then a worker claims it with a lease.
# Off by default; the inline path is unchanged until this is enabled.
QUEUE_DISPATCH=false
# Admission control when the dispatcher is on.
QUEUE_MAX_DEPTH=100
QUEUE_MAX_PER_USER=20
# GitHub API budget per token. GitHub allows 5000/hour; keep a margin.
GITHUB_REQUESTS_PER_MINUTE=120
# Prometheus /metrics. A production start refuses an empty METRICS_TOKEN, and the
# token is read from `Authorization: Bearer <METRICS_TOKEN>` only; a `?token=`
# query value is rejected. Outside production an empty value leaves the endpoint
# loopback-only, which is development and test only.
METRICS_TOKEN=
# Optional OTLP/HTTP JSON trace export, e.g. http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fledge
# Wait this long for running jobs before shutdown exits.
SHUTDOWN_GRACE_SECONDS=20
# Re-check open Fledge PRs for auto-merge at most this often.
AUTO_MERGE_RECONCILE_MINUTES=5
# Do not repeat the same operational alert within this window.
OPS_ALERT_COOLDOWN_MINUTES=360

# Optional outbound notification webhook (Slack-compatible text plus event fields).
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
