# Fledge behind nginx. Replace fledge.example.com and the TLS paths.
server {
  listen 443 ssl http2;
  server_name fledge.example.com;

  ssl_certificate     /etc/letsencrypt/live/fledge.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/fledge.example.com/privkey.pem;

  client_max_body_size 25m;

  # Named files so deploy/logrotate-fledge.conf rotates Fledge's logs instead of
  # competing with the distribution's rotation of access.log/error.log.
  access_log /var/log/nginx/fledge-access.log;
  error_log  /var/log/nginx/fledge-error.log warn;

  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Server-sent events from the model gateway.
  location /v1/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 30m;
  }
}

server {
  listen 80;
  server_name fledge.example.com;
  return 301 https://$host$request_uri;
}
