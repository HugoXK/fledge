# Fledge behind nginx. Replace fledge.example.com and the TLS paths.
server {
  listen 443 ssl http2;
  server_name fledge.example.com;

  ssl_certificate     /etc/letsencrypt/live/fledge.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/fledge.example.com/privkey.pem;

  client_max_body_size 25m;

  # Named files so deploy/logrotate-fledge.conf rotates Fledge's logs instead of
  # competing with the distribution's rotation of access.log/error.log.
  access_log /var/log/nginx/fledge-access.log;
  error_log  /var/log/nginx/fledge-error.log warn;

  # #1009: the console's security headers, at server level so `location /` and
  # `location /v1/` inherit them. `always` keeps them on the 4xx/5xx nginx
  # generates itself, such as a 502 while the app is down; without it a plain
  # `add_header` is skipped on those responses. A `location` that declares an
  # `add_header` of its own would stop inheriting this set, so it has to repeat
  # all four.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "DENY" always;

  location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Server-sent events from the model gateway.
  location /v1/ {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 30m;
  }
}

server {
  listen 80;
  server_name fledge.example.com;

  # The redirect is nginx's own response, so it needs the same set. HSTS here is
  # a no-op on plain HTTP, but the other three apply, and repeating the block
  # keeps the sample honest about the inheritance rule above.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "DENY" always;

  return 301 https://$host$request_uri;
}
